include README.md
recursive-include docs *.md *.json
recursive-include configs *.toml
recursive-include examples *.md
recursive-include scripts *.sh *.py
recursive-include tests *.py *.gd *.godot *.tscn *.json
recursive-include src *.gd *.js *.json *.txt
prune .venv
prune outputs
prune build
prune dist
global-exclude *.pyc
global-exclude __pycache__
exclude configs/local.toml
